-- CORNER_POINT_EXAMPLE.GRDECL

-- To open this file in ResInsight, go to:
-- File > Import > Eclipse Cases > Import Input Eclipse Case

-- Specification of the grid characteristics
SPECGRID
-- NX NY NZ NUMRES TYPE
   2  1  1    1     F / 


-- Pairs of coordinates of 
-- (NX+1)*(NY+1) = 6 pillars
COORD
--  X1  Y1  Z1   X2  Y2  Z2
    0   0   0    0   0   100
    100 0   0    100 0   100
    200 0   0    200 0   100
    0   100 0    0   100 100
    100 100 0    100 100 100
    200 100 0    200 100 100 /


-- Depths of 8*NX*NY*NZ = 16 
-- corner points
ZCORN
    0   0   20  20
    0   0   20  20
    80  80  100 100
    80  80  100 100 /
